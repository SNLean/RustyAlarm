# Servicio de suscripcion (saas/). Copiar a .env y completar.
# El proceso lee estas variables desde el entorno (ver saas/config.py).

# URL publica del sitio. TIENE que coincidir con el dominio real o el login de
# Steam falla (Steam redirige a esta URL). En local: http://127.0.0.1:8000
RUSTALARM_BASE_URL=http://127.0.0.1:8000

# Interfaz y puerto de escucha.
RUSTALARM_HOST=127.0.0.1
RUSTALARM_PORT=8000

# SteamID64 del dueno del servicio: es quien ve /admin.
RUSTALARM_ADMIN_STEAM_ID=

# Alarmas maximas por usuario.
RUSTALARM_MAX_ALARMS=3

# Carpeta de datos (base SQLite). Default ./saas_data
# RUSTALARM_DATA_DIR=./saas_data
